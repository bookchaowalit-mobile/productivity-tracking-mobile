{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "isolatedModules": true
  },
  "include": ["app/**/*.ts", "tests/**/*.ts", "nativescript.config.ts", "vitest.config.ts"]
}
