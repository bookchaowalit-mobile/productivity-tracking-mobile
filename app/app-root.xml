<TabView loaded="onLoaded">
    <TabView.items>
        <TabViewItem title="Library">
            <TabViewItem.view>
                <GridLayout rows="auto, auto, auto, auto, *, auto">
                    <SearchBar row="0" hint="Search titles" text="{{ query }}" />
                    <SegmentedBar row="1" selectedIndex="{{ statusIndex }}" class="m-x-10" accessibilityLabel="Filter by status">

                        <SegmentedBar.items>
                            <SegmentedBarItem title="All" />
                            <SegmentedBarItem title="Doing" />
                            <SegmentedBarItem title="Planned" />
                            <SegmentedBarItem title="Done" />
                            <SegmentedBarItem title="Dropped" />
                        </SegmentedBar.items>
                    </SegmentedBar>
                    <ScrollView row="2" orientation="horizontal" class="m-x-10 m-t-5">
                        <SegmentedBar selectedIndex="{{ categoryIndex }}" items="{{ categoryFilters }}" accessibilityLabel="Filter by category" />
                    </ScrollView>
                    <Label row="3" text="{{ emptyText }}" visibility="{{ emptyText ? 'visible' : 'collapsed' }}" class="text-center p-20" textWrap="true" />
                    <ListView row="4" items="{{ rows }}" itemTap="{{ onItemTap }}">
                        <ListView.itemTemplate>
                            <StackLayout class="p-10">
                                <Label text="{{ title }}" class="font-weight-bold" textWrap="true" />
                                <Label text="{{ subtitle }}" class="text-muted" textWrap="true" />
                            </StackLayout>
                        </ListView.itemTemplate>
                    </ListView>
                    <Button row="5" text="Add item" tap="{{ onAdd }}" class="-primary m-10" accessibilityLabel="Add item to track" />
                </GridLayout>
            </TabViewItem.view>
        </TabViewItem>
        <TabViewItem title="Stats">
            <TabViewItem.view>
                <ScrollView>
                    <StackLayout class="p-20">
                        <Label text="{{ summary }}" class="text-lg font-weight-bold" textWrap="true" />
                        <Label text="By status" class="m-t-20 font-weight-bold" />
                        <Label text="{{ statusLines }}" textWrap="true" />
                        <Label text="By category" class="m-t-20 font-weight-bold" />
                        <Label text="{{ categoryLines }}" textWrap="true" />
                    </StackLayout>
                </ScrollView>
            </TabViewItem.view>
        </TabViewItem>
        <TabViewItem title="Profile">
            <TabViewItem.view>
                <StackLayout class="p-20">
                    <Label text="Chaowalit Greepoke" class="text-xl font-bold text-center" />
                    <Label text="bookchaowalit.com" class="text-center" />
                </StackLayout>
            </TabViewItem.view>
        </TabViewItem>
    </TabView.items>
</TabView>
